#!/usr/bin/env bash
# shellcheck shell=bash

set -Eeuo pipefail

if [[ ${ASDF_INSTALL_TYPE:-version} == 'ref' ]]; then
  echo >&2 "⛔ This plugin does not support installing by ref."
  exit 1
fi

FALLBACK_REGISTRY='https://registry.npmjs.org/'
# ASDF_PNPM_NO_FALLBACK=1 never falls back to the public registry, for setups
# where every download must come through a private mirror.
NO_FALLBACK="${ASDF_PNPM_NO_FALLBACK:-0}"

REGISTRY="${NPM_CONFIG_REGISTRY:-$FALLBACK_REGISTRY/}"
if command -v npm 1>/dev/null; then
  REGISTRY=$(npm config get registry --force 2>/dev/null)
fi

mkdir -p "${ASDF_DOWNLOAD_PATH}"

download_and_extract() {
  local reg="$1"
  local tarball_url="${reg%/}/pnpm/-/pnpm-${ASDF_INSTALL_VERSION}.tgz"
  local tmpfile
  tmpfile=$(mktemp)
  local http_code

  echo "Downloading pnpm v${ASDF_INSTALL_VERSION} from ${tarball_url}"
  http_code=$(curl --silent --write-out "%{http_code}" --location "${tarball_url}" -o "$tmpfile") || http_code="000"

  if [[ $http_code == "000" ]]; then
    echo >&2 "⛔ Failed to connect to ${tarball_url} (network/TLS error)"
    rm -f "$tmpfile"
    return 1
  elif [[ $http_code != "200" ]]; then
    echo >&2 "⛔ Failed to download from ${tarball_url} (HTTP ${http_code})"
    rm -f "$tmpfile"
    return 1
  fi

  tar xzf "$tmpfile" --strip-components=1 --no-same-owner -C "${ASDF_DOWNLOAD_PATH}"
  rm -f "$tmpfile"
}

# `npm pack` fetches the tarball with npm's own auth/CA/proxy handling, so it
# works against registries that reject anonymous requests (HTTP 401).
download_and_extract_npm() {
  local tmpdir tarball
  tmpdir=$(mktemp -d)
  echo "Downloading pnpm v${ASDF_INSTALL_VERSION} via npm pack (registry ${REGISTRY})"
  if ! tarball=$(npm pack "pnpm@${ASDF_INSTALL_VERSION}" --pack-destination "$tmpdir" --loglevel=error 2>&1); then
    echo >&2 "⛔ npm pack failed: $(echo "$tarball" | head -2)"
    rm -rf "$tmpdir"
    return 1
  fi
  tar xzf "${tmpdir}/$(echo "$tarball" | tail -1)" --strip-components=1 --no-same-owner -C "${ASDF_DOWNLOAD_PATH}"
  rm -rf "$tmpdir"
  download_platform_binary_npm
}

# The npm name of this host's native pnpm binary package, e.g. @pnpm/exe.darwin-arm64.
platform_package() {
  local os arch name
  case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) return 1 ;;
  esac
  case "$(uname -m)" in
  arm64 | aarch64) arch=arm64 ;;
  x86_64 | amd64) arch=x64 ;;
  *) return 1 ;;
  esac
  name="@pnpm/exe.${os}-${arch}"
  # musl's `ldd --version` prints its banner but exits 1, so ignore its status.
  if [[ $os == linux ]] && { ldd --version 2>&1 || true; } | grep -qi musl; then
    name+="-musl"
  fi
  echo "$name"
}

# pnpm 11+ is a thin wrapper around a native binary that ships as a
# per-platform optional dependency. `npm install` would put it in the wrapper's
# node_modules; `npm pack` doesn't, and the wrapper's first-run download
# refuses packages without npm registry signatures, which mirrors such as
# CodeArtifact don't carry. So fetch it the way `npm install` would. If that
# fails, pnpm still tries its own download on first run.
download_platform_binary_npm() {
  local pkg tmpdir tarball dest
  pkg=$(platform_package) || return 0
  # Only versions that ship a native binary list it as an optional dependency.
  grep -q "\"${pkg}\"" "${ASDF_DOWNLOAD_PATH}/package.json" || return 0
  dest="${ASDF_DOWNLOAD_PATH}/node_modules/${pkg}"
  tmpdir=$(mktemp -d)
  echo "Downloading ${pkg}@${ASDF_INSTALL_VERSION} via npm pack"
  if ! tarball=$(npm pack "${pkg}@${ASDF_INSTALL_VERSION}" --pack-destination "$tmpdir" --loglevel=error 2>&1); then
    echo >&2 "⚠️ npm pack ${pkg} failed, so pnpm will download it on first run: $(echo "$tarball" | head -2)"
    rm -rf "$tmpdir"
    return 0
  fi
  mkdir -p "$dest"
  tar xzf "${tmpdir}/$(echo "$tarball" | tail -1)" --strip-components=1 --no-same-owner -C "$dest"
  rm -rf "$tmpdir"
}

if command -v npm 1>/dev/null && download_and_extract_npm; then
  exit 0
fi

# Try configured registry first, fall back to default if different and first attempt fails
if ! download_and_extract "$REGISTRY" 2>/dev/null; then
  if [[ ${REGISTRY%/} != "${FALLBACK_REGISTRY%/}" && $NO_FALLBACK != 1 ]]; then
    echo "Download from configured registry failed, trying fallback registry..."
    download_and_extract "$FALLBACK_REGISTRY"
  else
    echo "Download from registry failed."
    [[ $NO_FALLBACK == 1 ]] && echo "Not trying ${FALLBACK_REGISTRY} (ASDF_PNPM_NO_FALLBACK=1)."
    exit 1
  fi
fi
